# Mailflare Docker environment
# Copy to .env.docker and edit:  cp .env.docker.example .env.docker
# Docs: docs/self-hosting.md

# --- Required for a local / first run ---
PORT=3000
DATA_DIR=/data
# Public URL of this install (use https://mail.example.com behind a reverse proxy)
APP_URL=http://localhost:3000

# Inbound SMTP listener. Docker Desktop / local: 2525 (compose maps 2525:2525).
# Production VPS with real MX: set 25 and publish 25:25 in docker-compose.yml.
# Set 0 to disable the listener (e.g. when using the Cloudflare email relay only).
SMTP_INBOUND_PORT=2525
# Host name shown in the SMTP banner and recommended as the MX target
MAIL_HOSTNAME=localhost

# --- Outbound sending (pick one) ---
# Any SMTP relay (SES SMTP, Postmark, Mailgun, your host's relay, …)
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# SMTP_TLS_REJECT_UNAUTHORIZED=true

# Or Cloudflare Email Sending (needs Email Sending:Edit on the token)
# CF_ACCOUNT_ID=your_cloudflare_account_id
# CF_TOKEN=your_api_token_with_zone_and_email_permissions

# --- Optional: Cloudflare DNS / Email Routing for domains you add in the app ---
# Same CF_TOKEN as above can cover DNS + Email Routing Rules edit.

# --- Optional: receive via Cloudflare Email Routing relay Worker ---
# INBOUND_WEBHOOK_SECRET=long-random-secret
# INBOUND_REQUIRE_SIGNED_HEADERS=1

# --- Optional: external database (default is SQLite under DATA_DIR) ---
# DATABASE_URL=postgres://mailflare:change-me@db:5432/mailflare
# DATABASE_DRIVER=postgres

# --- Optional: object storage (default is files under /data/blobs) ---
# B2_KEY_ID=
# B2_APPLICATION_KEY=
# B2_BUCKET=mailflare
# B2_ENDPOINT=s3.us-west-004.backblazeb2.com
# S3_BUCKET=mailflare
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Optional: Resend / Amazon SES (or configure later in Admin → Domains) ---
# RESEND_API_KEY=re_...
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# --- Optional: inbound SMTP STARTTLS (paths inside the container) ---
# SMTP_TLS_KEY=/data/certs/privkey.pem
# SMTP_TLS_CERT=/data/certs/fullchain.pem
# SMTP_MAX_SIZE=37748736

# --- Optional: reverse proxy / bot protection / Web Push / AI ---
# TRUST_PROXY=1
# TURNSTILE_SECRET_KEY=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=
# AI_MODEL=gpt-4o-mini
